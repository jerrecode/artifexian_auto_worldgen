# Python virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
.coverage.*
htmlcov/

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# IDE / editor / OS noise
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs / temporary runtime files
*.log
*.tmp
*.temp
*.bak
*.pid

# Generated world outputs
world_arrays.npz
world.json
world_report.md
features.geojson
maps/
atlas_all/
data_tables/
diagnostic_maps/
analysis/
outputs/
output/
generated/
generated_worlds/
worldgen_run/
worldgen_*_seed_*/
worldgen_*_check*/
worldgen_*_validation*/
artifexian_*_world/

# Large generated data / map / archive products
*.npy
*.npz
*.zarr/
*.h5
*.hdf5
*.nc
*.tif
*.tiff
*.geotiff
*.mbtiles
*.parquet
*.feather
*.sqlite
*.sqlite3
*.db
*.tar
*.tar.gz
*.tar.zst
*.tgz
*.zip

# Generated image/map outputs
*.png
*.jpg
*.jpeg
*.webp
*.svg

# Keep source-controlled documentation assets if added explicitly later
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.webp
!docs/**/*.svg

# Local environment / secrets
.env
.env.*
!.env.example
